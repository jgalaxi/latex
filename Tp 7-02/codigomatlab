%% Análisis de viga en voladizo - Selección de material por masa mínima
clear; clc; close all;

% Parámetros iniciales
F = 1000;           % Fuerza aplicada [Kg]
L = 10;           % Longitud [m]
deflexion = 1e-2;  % Deflexión máxima permitida [m]

% Lista de materiales (nombre, E [Pa], densidad [kg/m^3])
materiales = {
    'Acero F24',        210e9,    7850;
    'Aluminio 6063',    69e9,    2700;
    'Titanio AlyV',     114e9,    4430;
    'Madera de roble',  11e9,     770;
    'Teflón',           150e9,    160
};

n = size(materiales,1);

% Inicialización
t = zeros(n,1);   % espesor requerido
m = zeros(n,1);   % masa resultante
M = zeros(n,1);   % índice de Ashby

% Cálculos
for i = 1:n
    E = materiales{i,2};
    rho = materiales{i,3};
    
    % Espesor necesario para cumplir deflexión
    t(i) = (4*F*10*L^3/(E*deflexion))^(1/4);
    
    % Masa correspondiente
    m(i) = rho * L * t(i)^2;
    
    % Índice de Ashby
    M(i) = sqrt((rho*rho)/E);
end

% Crear tabla de resultados
T = table(string(materiales(:,1)), t, m, M, ...
    'VariableNames', {'Material','Espesor_m','Masa_kg','Indice_Ashby'});

% Ordenar por masa (de menor a mayor)
T = sortrows(T, 'Masa_kg', 'ascend');

% Mostrar resultados
disp('=== Resultados ordenados por masa mínima ===');
disp(T);


% --- Gráfico de índice de Ashby ---
figure;
bar(categorical(T.Material), T.Indice_Ashby);
ylabel('Índice de Ashby  ρ^{2} / E');
title('Eficiencia de materiales en rigidez-peso (viga en flexión)');
grid on;
